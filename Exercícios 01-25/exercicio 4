n1 = (input('Digite algo:'))
print('O tipo primitivo dele é:', type(n1))
print("Só tem espaços?", n1.isspace())
print('Esta em caps lock?', n1.isupper())
print('Esta em minusculo?', n1.islower())
print('Esta em titulo?', n1.istitle())
print('Tem apenas numeros?', n1.isnumeric())
print('Tem apenas letras?', n1.isalpha())
print('Tem apenas digitos?', n1.isdigit())
print('Tem apenas letras e numeros?', n1.isalnum())