n1 = float(input('Digite sua primeira nota:'))
n2 = float(input('Digite sua segunda nota:'))
n3 = float(input('Digite sua terceira nota:'))
media = (n1 + n2 + n3) / 3
if media < 5.0:
    print(f'Sua média é {media:.1f}. Você foi \033[31mREPROVADO!\033[0m')
elif media >= 5.0 and media < 7.0:
    print(f'Sua média é {media:.1f}. Você está de \033[33mRECUPERAÇÃO!\033[0m')
else:    print(f'Sua média é {media:.1f}, Parabéns, você foi \033[32mAPROVADO!\033[0m')