maioridade = 0
menoridade = 0
for c in range(1, 8):
    idade = int(input(f"Digite a idade da {c}ª pessoa: "))
    if idade >= 18:
        maioridade += 1
    else:
        menoridade += 1
print(f"Total de pessoas maiores de idade: {maioridade}")
print(f"Total de pessoas menores de idade: {menoridade}")