from random import randint
n1 = int(input('Digite um número de 0 a 10:'))
numero = randint(0,10)
tentativas = 1
while n1 != numero:
    if n1 < numero:
        print('\033[33mTente um número maior!\033[0m')
    else:
        print('\033[34mTente um número menor!\033[0m')
    n1 = int(input('Digite um número de 0 a 10:'))
    tentativas += 1
print(f'\033[32mParabéns, você acertou com {tentativas} tentativas!\033[0m')