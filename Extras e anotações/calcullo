# 3. ALGORITMOS DE CÁLCULO
# ==========================================
def calcular_limite(f, x0, tol=1e-7):
    # Diferença central simples com aproximação progressiva
    h = 0.1
    for _ in range(15):
        try:
            esq = f(x0 - h)
            dir = f(x0 + h)
            if abs(esq - dir) < tol: return (esq + dir) / 2
        except: pass
        h /= 2
    return f(x0 + 1e-10) # Fallback para aproximação lateral direita

def calcular_integral(f, a, b, n=1000):
    # Regra de Simpson Composta
    if n % 2 != 0: n += 1
    h = (b - a) / n
    soma = f(a) + f(b)
    for i in range(1, n, 2): soma += 4 * f(a + i * h)
    for i in range(2, n-1, 2): soma += 2 * f(a + i * h)
    return (h / 3) * soma

