import math
import ast

# ==========================================
# 1. MOTOR MATEMÁTICO: Números Duais
# ==========================================
class NumeroDual:
    def __init__(self, real, dual=0.0):
        self.real = float(real)
        self.dual = float(dual)

    def __add__(self, outro):
        outro = outro if isinstance(outro, NumeroDual) else NumeroDual(outro)
        return NumeroDual(self.real + outro.real, self.dual + outro.dual)
    def __radd__(self, outro): return self + outro

    def __sub__(self, outro):
        outro = outro if isinstance(outro, NumeroDual) else NumeroDual(outro)
        return NumeroDual(self.real - outro.real, self.dual - outro.dual)
    def __rsub__(self, outro): return NumeroDual(outro) - self

    def __mul__(self, outro):
        outro = outro if isinstance(outro, NumeroDual) else NumeroDual(outro)
        return NumeroDual(self.real * outro.real, self.real * outro.dual + self.dual * outro.real)
    def __rmul__(self, outro): return self * outro

    def __truediv__(self, outro):
        outro = outro if isinstance(outro, NumeroDual) else NumeroDual(outro)
        if outro.real == 0: raise ZeroDivisionError("Divisão por zero.")
        return NumeroDual(self.real / outro.real, (self.dual * outro.real - self.real * outro.dual) / (outro.real ** 2))
    def __rtruediv__(self, outro): return NumeroDual(outro) / self

    def __pow__(self, expoente):
        outro = expoente if isinstance(expoente, NumeroDual) else NumeroDual(expoente)
        novo_real = self.real ** outro.real
        # Regra geral para f(x)^g(x) usando derivação logarítmica
        termo1 = outro.real * (self.real ** (outro.real - 1)) * self.dual
        termo2 = (self.real ** outro.real) * math.log(self.real) * outro.dual if self.real > 0 else 0
        return NumeroDual(novo_real, termo1 + termo2)

# Funções transcendentes preparadas para o AST e Números Duais
def sen(x):
    if isinstance(x, NumeroDual): return NumeroDual(math.sin(x.real), math.cos(x.real) * x.dual)
    return math.sin(x)

def cos(x):
    if isinstance(x, NumeroDual): return NumeroDual(math.cos(x.real), -math.sin(x.real) * x.dual)
    return math.cos(x)

def tan(x):
    if isinstance(x, NumeroDual): return NumeroDual(math.tan(x.real), (1.0 / math.cos(x.real)**2) * x.dual)
    return math.tan(x)

def exp(x):
    if isinstance(x, NumeroDual): return NumeroDual(math.exp(x.real), math.exp(x.real) * x.dual)
    return math.exp(x)

def ln(x):
    if isinstance(x, NumeroDual): return NumeroDual(math.log(x.real), (1.0 / x.real) * x.dual)
    return math.log(x)

# ==========================================
# 2. COMPILADOR: Avaliador de Árvore AST
# ==========================================
class FuncaoDinamica:
    """
    Transforma texto humano em lógica computacional executável.
    Analisa a string matemática e cria um avaliador recursivo blindado.
    """
    def __init__(self, expressao):
        expressao = expressao.replace('^', '**') # Adapta para sintaxe Python
        self.arvore = ast.parse(expressao, mode='eval').body
        self.ambiente = {'sin': sen, 'cos': cos, 'tan': tan, 'exp': exp, 'ln': ln, 'e': math.e, 'pi': math.pi}

    def __call__(self, x):
        return self._avaliar_no(self.arvore, x)

    def _avaliar_no(self, no, x):
        if isinstance(no, ast.Constant): return no.value
        elif isinstance(no, ast.Name):
            if no.id == 'x': return x
            if no.id in self.ambiente: return self.ambiente[no.id]
            raise NameError(f"Variável ou função desconhecida: '{no.id}'")
        elif isinstance(no, ast.BinOp):
            esq = self._avaliar_no(no.left, x)
            dir = self._avaliar_no(no.right, x)
            if isinstance(no.op, ast.Add): return esq + dir
            if isinstance(no.op, ast.Sub): return esq - dir
            if isinstance(no.op, ast.Mult): return esq * dir
            if isinstance(no.op, ast.Div): return esq / dir
            if isinstance(no.op, ast.Pow): return esq ** dir
        elif isinstance(no, ast.Call):
            func = self._avaliar_no(no.func, x)
            arg = self._avaliar_no(no.args[0], x)
            return func(arg)
