saldo = float(input("Digite o saldo da conta em reais:"))
verde = '\033[32m'
vermelho = '\033[31m'
reset = '\033[0m'
azul = '\033[34m'
if saldo > 0:
    print(f"{verde}Saldo positivo{reset}")
elif saldo < 0:
    print(f"{vermelho}Saldo negativo, pague suas dividas caloteiro!{reset}")
else:
    print(f"{azul}Saldo neutro{reset}")

